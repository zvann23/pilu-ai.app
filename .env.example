NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=

# Server-only — required for the /api/cron/* summary routes (bypasses RLS
# to read across every family). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`.
# Optional locally; the cron routes only check it when it's set.
CRON_SECRET=

# Push notifications (Phase 19) — set NEXT_PUBLIC_PUSH_PROVIDER to "fcm" or
# "onesignal" and that provider's own vars below to go live. Leave unset to
# keep push in its safe no-op state; in-app notifications work either way.
NEXT_PUBLIC_PUSH_PROVIDER=
NEXT_PUBLIC_FCM_VAPID_KEY=
FCM_SERVER_KEY=
FCM_PROJECT_ID=
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Google Play Billing (Phase 20) — server-side purchase verification via
# the Play Developer API. Leave unset locally; /api/billing/* routes
# return a clear "not configured" response rather than crash. See the
# setup notes in lib/billing/google-play-client.ts.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
# Shared secret appended as ?secret=<value> on the Play Console Pub/Sub
# push endpoint URL. Optional locally; the RTDN route only checks it when set.
RTDN_WEBHOOK_SECRET=
